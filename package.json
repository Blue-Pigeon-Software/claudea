{
  "name": "claudea",
  "version": "1.1.0",
  "description": "Interaktywny menedżer niezależnych kont Claude Code (osobny CLAUDE_CONFIG_DIR na konto)",
  "type": "module",
  "bin": {
    "claudea": "bin/claudea.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/claudea.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "node --check bin/claudea.js && for f in src/*.js; do node --check \"$f\" || exit 1; done && npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "multi-account",
    "cli",
    "accounts",
    "claude-config-dir"
  ],
  "author": "Jakub Puzia (Blue Pigeon Software)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blue-Pigeon-Software/claudea.git"
  },
  "homepage": "https://github.com/Blue-Pigeon-Software/claudea#readme",
  "bugs": {
    "url": "https://github.com/Blue-Pigeon-Software/claudea/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1"
  }
}
